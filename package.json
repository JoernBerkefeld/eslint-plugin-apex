{
    "name": "eslint-plugin-apex",
    "version": "0.1.0",
    "description": "ESLint plugin for Salesforce Apex — ports PMD Apex rules to the ESLint ecosystem",
    "type": "module",
    "main": "src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./parser": "./src/apex-parser.js"
    },
    "files": [
        "src",
        "docs",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoernBerkefeld/eslint-plugin-apex.git"
    },
    "bugs": {
        "url": "https://github.com/JoernBerkefeld/eslint-plugin-apex/issues"
    },
    "homepage": "https://github.com/JoernBerkefeld/eslint-plugin-apex#readme",
    "author": "Joern Berkefeld",
    "license": "MIT",
    "keywords": [
        "eslint",
        "eslintplugin",
        "apex",
        "salesforce",
        "pmd",
        "linter",
        "static-analysis",
        "salesforce-core-platform"
    ],
    "dependencies": {
        "@apexdevtools/apex-parser": "^5.0.0-beta.5"
    },
    "peerDependencies": {
        "eslint": ">=9.0.0"
    },
    "devDependencies": {
        "eslint": "^10.2.0"
    },
    "scripts": {
        "test": "node --test tests/rules.test.js tests/parser.test.js"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
